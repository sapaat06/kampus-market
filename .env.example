PORT=3000

# Database LibSQL / Turso
# Produksi (Turso): libsql://your-db-name.turso.io
# Pengembangan lokal fallback: file:app.db
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Cloudinary Storage untuk Foto Barang & Properti
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
# Kosongkan atau biarkan placeholder untuk mode lokal: foto disimpan sebagai
# data URL di database (tanpa upload ke Cloudinary).
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Kunci untuk endpoint admin (header x-admin-key). Wajib diisi di produksi.
ADMIN_KEY=ganti-dengan-kunci-rahasia
# Penanda tanda tangan token login. Kalau kosong, acak tiap server start (login hilang saat restart).
SECRET=ganti-dengan-string-acak-panjang

# Environment Render: aktifkan mode production untuk cookie HTTPS Secure
# NODE_ENV=production
# RATE_LIMIT_DISABLED=1

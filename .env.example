PORT=3000
DB=app.db
# Kunci untuk endpoint admin (header x-admin-key). Wajib diisi, kalau kosong route admin mati.
ADMIN_KEY=ganti-dengan-kunci-rahasia
# Penanda tanda tangan token login. Kalau kosong, acak tiap server start (login hilang saat restart).
SECRET=ganti-dengan-string-acak-panjang
# Set 1 kalau aplikasi di belakang reverse proxy (nginx), agar rate limit memakai IP asli.
# TRUST_PROXY=1
# Set production agar cookie sesi memakai flag Secure. Wajib lewat HTTPS.
# NODE_ENV=production
# Hanya untuk pengembangan/tes: matikan rate limit.
# RATE_LIMIT_DISABLED=1
